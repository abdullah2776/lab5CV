<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Portfolio</title>
    <link rel="stylesheet" href="site.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#">MyPortfolio</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="#home">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
                    <li class="nav-item"><a class="nav-link" href="#skills">Skills</a></li>
                    <li class="nav-item"><a class="nav-link" href="#portfolio">Projects</a></li>
                    <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
                </ul>
                <!-- Dark Mode Toggle -->
                <button id="themeToggle" class="theme-toggle" title="Toggle Dark Mode">
                    <i class="bi bi-moon"></i>
                </button>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <header id="home">
        <div class="container">
            <h1 class="display-4 fw-bold">Hello, I'm <span class="text-warning">Abdullah Qubbaj</span></h1>
            <p class="lead">A Passionate Web Developer & Designer</p>
            <a href="#contact" class="btn btn-light btn-lg mt-3">Contact Me</a>
        </div>
    </header>

    <!-- About Section -->
    <section id="about" class="py-5 text-center">
        <div class="container">
            <h2 class="fw-bold mb-4">About Me</h2>
            <img src="https://media.licdn.com/dms/image/v2/D4E03AQFbpZ3uN7rboQ/profile-displayphoto-shrink_800_800/B4EZaXpDMeGQAg-/0/1746300844174?e=1762992000&v=beta&t=j7ulLWj7IPYbE6rt9c3E0CDO3OIISmm_stlT4QDlGQw" alt="Profile Picture" class="mb-3">
            <p class="lead">I am a CIS student who is intrested in building creative, beautiful and functional websites. I love to work with the latest web technologies and always aim to deliver top-quality work.</p>
        </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="py-5 bg-light">
        <div class="container">
            <h2 class="fw-bold text-center mb-5">My Skills</h2>
            <div class="row">
                <div class="col-md-6">
                    <h5>HTML</h5>
                    <div class="progress mb-3">
                        <div class="progress-bar bg-primary" style="width: 95%">95%</div>
                    </div>
                    <h5>CSS</h5>
                    <div class="progress mb-3">
                        <div class="progress-bar bg-success" style="width: 90%">90%</div>
                    </div>
                    <h5>Bootstrap</h5>
                    <div class="progress mb-3">
                        <div class="progress-bar bg-info" style="width: 85%">85%</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <h5>JavaScript</h5>
                    <div class="progress mb-3">
                        <div class="progress-bar bg-warning" style="width: 80%">80%</div>
                    </div>
                    <h5>React</h5>
                    <div class="progress mb-3">
                        <div class="progress-bar bg-danger" style="width: 70%">70%</div>
                    </div>
                    <h5>Python</h5>
                    <div class="progress mb-3">
                        <div class="progress-bar bg-secondary" style="width: 85%">85%</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Portfolio Section -->
    <section id="portfolio" class="py-5">
        <div class="container">
            <h2 class="fw-bold text-center mb-5">My Projects</h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card portfolio-card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">Digital Keyboard</h5>
                            <p class="card-text">A digital keyboard to help you type if your physical keyboard has issues.</p>
                            <div class="btn btn-primary ">C#</div>
                            <div class="btn btn-primary ">Visual Studio</div>
                            <div class="btn btn-primary ">Design</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card portfolio-card shadow-sm">

                        <div class="card-body">
                            <h5 class="card-title">Design System</h5>
                            <p class="card-text">Component library with tokens, documentation, and examples.</p>
                            <div class="btn btn-primary ">Tokens</div>
                            <div class="btn btn-primary ">Components</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card portfolio-card shadow-sm">

                        <div class="card-body">
                            <h5 class="card-title">Android Studio</h5>
                            <p class="card-text">A complete app to help you achieve your goals and increase productivity.</p>
                            <div class="btn btn-primary ">Android Studio</div>
                            <div class="btn btn-primary ">Java</div>
                            <div class="btn btn-primary ">Kotlin</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-5 bg-light">
        <div class="container">
            <h2 class="fw-bold text-center mb-5">Contact Me</h2>
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <form>
                        <div class="mb-3">
                            <label for="name" class="form-label">Name</label>
                            <input type="text" class="form-control" id="name" placeholder="Enter your name" required>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" placeholder="Enter your email" required>
                        </div>
                        <div class="mb-3">
                            <label for="message" class="form-label">Message</label>
                            <textarea id="message" class="form-control" rows="5" placeholder="Write your message" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="text-center">
        <div class="container">
            <p>&copy; 2025 Abdullah Qubbaj | All Rights Reserved</p>
            <div>
                <a href="https://github.com/abdullah2776"><i class="bi bi-github"></i></a>
                <a href="https://www.linkedin.com/in/abdullah-qubbaj-32159a342/"><i class="bi bi-linkedin"></i></a>
                <a href="https://www.instagram.com/abdullah_qubbaj/"><i class="bi bi-instagram"></i></a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="site.js"></script>
</body>
</html>
